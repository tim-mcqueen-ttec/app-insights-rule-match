# Copy to .env.local and fill in. Vite builds these into the page, so only use test credentials.

# Required: the username and password of a Telnyx SIP Connection with Credentials authentication
# (Mission Control Portal > Voice > SIP Trunking). The same values you'd pass to new TelnyxRTC({ login, password }).
VITE_TELNYX_LOGIN=
VITE_TELNYX_PASSWORD=

# Required: who to call, as an E.164 number or a SIP URI (name@sip.example.com). It must answer: the SDK only
# has a call report to post once the call has connected with media.
VITE_TELNYX_DESTINATION=+17192662837

# Optional: caller ID for the call. To dial a phone number this usually has to be a number on your Telnyx account
# that's assigned to the SIP Connection above (or set an outbound voice profile on the connection).
VITE_TELNYX_CALLER_NUMBER=

# Optional: a real Application Insights connection string. Without one the page uses a placeholder and sends its
# telemetry to a stub on the dev server. The bug happens either way.
VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=
